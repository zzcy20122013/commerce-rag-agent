# Project environment template.
# Keep this file public and do not put real API keys here.
# Before running the backend, copy it to backend/.env and fill in your local values.

# LLM provider.
LLM_PROVIDER=doubao
DOUBAO_API_KEY=
ARK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Some Ark accounts require an endpoint id such as ep-xxx instead of a display model name.
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
# Optional VLM settings for photo shopping.
# Use DOUBAO_VISION_MODEL for a dedicated vision endpoint, or set
# DOUBAO_VISION_REUSE_TEXT_MODEL=true when DOUBAO_MODEL supports image input.
DOUBAO_VISION_API_KEY=
DOUBAO_VISION_BASE_URL=
DOUBAO_VISION_MODEL=
DOUBAO_VISION_REUSE_TEXT_MODEL=false
LLM_TIMEOUT_SECONDS=60
VLM_TIMEOUT_SECONDS=60

# SSE output. A small delay keeps safe, post-checked answers visibly streaming.
SSE_CHUNK_DELAY_SECONDS=0.04

# Backend guardrails.
MAX_BODY_SIZE_MB=10
MAX_CONCURRENT_REQUESTS=10
UPLOAD_RETENTION_HOURS=24
IMAGE_MAX_PIXELS=25000000

# Backend runtime data. These paths are relative to the backend/ working directory.
DATABASE_URL=sqlite:///./app/data/commerce.db
CHROMA_PATH=./app/data/chroma

# Embedding providers. Use local models by default.
EMBEDDING_PROVIDER=local
TEXT_EMBEDDING_PROVIDER=bge_m3
IMAGE_EMBEDDING_PROVIDER=chinese_clip

# Local model cache. This path resolves to <repo>/models/huggingface when backend runs from backend/.
HF_HOME=../models/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_USE_FP16=false
BGE_M3_BATCH_SIZE=16
BGE_M3_ENABLE_REAL=true

CHINESE_CLIP_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
CHINESE_CLIP_DEVICE=cpu
CHINESE_CLIP_ENABLE_REAL=true
CHINESE_CLIP_LOCAL_FILES_ONLY=true
